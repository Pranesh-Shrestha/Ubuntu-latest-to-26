ARG BASE_IMAGE=ubuntu:26.04
FROM ${BASE_IMAGE}

RUN set -e; \
    echo "OS = $(. /etc/os-release && echo $PRETTY_NAME)"; \
    if command -v apt-get >/dev/null; then \
      . /etc/os-release; \
      case "$VERSION_CODENAME" in stretch|buster) \
        sed -i 's|deb.debian.org|archive.debian.org|g; s|security.debian.org|archive.debian.org|g; /-updates/d' /etc/apt/sources.list ;; \
      esac; \
      echo "apt = $(dpkg-query -W -f='${Version}' apt)"; \
      apt-get -o Acquire::Check-Valid-Until=false update; \
      apt-get install -y --no-install-recommends curl ca-certificates tree; \
    elif command -v apk >/dev/null; then \
      apk add --no-cache curl ca-certificates tree; \
    elif command -v dnf >/dev/null; then \
      dnf install -y tree || dnf -y makecache; \
    else \
      if grep -qs "release 7" /etc/centos-release; then \
        sed -i 's|^mirrorlist|#mirrorlist|; s|^#baseurl=http://mirror.centos.org|baseurl=http://vault.centos.org|' /etc/yum.repos.d/CentOS-*.repo; \
      fi; \
      yum install -y tree; \
    fi; \
    curl -sS -o /dev/null -w "google https = %{http_code}\n" https://www.google.com
